<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>G Borbon | Creative. Digital. Print.</title>

<meta name="description" content="Delivering digital + creative + print solutions through a network of brands.">

<meta name="theme-color" content="#0A0A0B">

<meta property="og:title" content="G Borbon | Creative. Digital. Print.">
<meta property="og:description" content="Delivering digital + creative + print solutions.">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

:root{

--bg:#09090B;
--surface:#111217;
--surface-hover:#181A20;

--border:rgba(255,255,255,.08);

--text:#F8FAFC;
--muted:#9CA3AF;

--primary:#A855F7;
--primary-light:#C084FC;

--radius:20px;

--shadow:
0 20px 60px rgba(0,0,0,.45);

--max-width:1220px;

}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{

scroll-behavior:smooth;

}

body{

font-family:'Geist',sans-serif;

background:var(--bg);

color:var(--text);

overflow-x:hidden;

line-height:1.6;

}

/**************************************************
BACKGROUND
**************************************************/

body::before{

content:"";

position:fixed;

inset:0;

background:

radial-gradient(circle at 20% 10%,rgba(168,85,247,.18),transparent 35%),

radial-gradient(circle at 80% 30%,rgba(120,60,255,.14),transparent 30%),

radial-gradient(circle at 50% 90%,rgba(120,60,255,.12),transparent 40%);

pointer-events:none;

z-index:-2;

animation:floatGlow 18s linear infinite;

}

@keyframes floatGlow{

0%{

transform:translateY(0px);

}

50%{

transform:translateY(-30px);

}

100%{

transform:translateY(0px);

}

}

/**************************************************
LAYOUT
**************************************************/

.container{

width:min(var(--max-width),92%);

margin:auto;

}

/**************************************************
HEADER
**************************************************/

header{

position:fixed;

top:0;

left:0;

right:0;

z-index:999;

backdrop-filter:blur(18px);

background:rgba(9,9,11,.55);

border-bottom:1px solid rgba(255,255,255,.04);

transition:.35s;

}

nav{

height:78px;

display:flex;

justify-content:space-between;

align-items:center;

}

.logo{

display:flex;

align-items:center;

gap:14px;

text-decoration:none;

color:#fff;

}

.logo img{

height:48px;

width:auto;

}

.logo span{

font-size:1.2rem;

font-weight:700;

letter-spacing:-.03em;

}

/**************************************************
NAV
**************************************************/

nav ul{

display:flex;

gap:40px;

list-style:none;

}

nav a{

text-decoration:none;

color:var(--muted);

font-weight:500;

transition:.25s;

}

nav a:hover{

color:#fff;

}

/**************************************************
HERO
**************************************************/

.hero{

min-height:100vh;

display:flex;

align-items:center;

justify-content:center;

text-align:center;

padding:160px 20px 100px;

}

.hero-logo{

width:110px;

margin:0 auto 40px;

display:block;

filter:drop-shadow(0 0 35px rgba(168,85,247,.35));

}

.hero h1{

font-size:clamp(3rem,8vw,5rem);

line-height:1.03;

letter-spacing:-0.05em;

font-weight:700;

max-width:900px;

margin:auto;

}

.hero h1 span{

background:linear-gradient(

90deg,

#FFFFFF,

#E7D4FF,

#FFFFFF

);

background-size:200%;

-webkit-background-clip:text;

-webkit-text-fill-color:transparent;

animation:gradientMove 7s linear infinite;

}

@keyframes gradientMove{

0%{

background-position:0%;

}

100%{

background-position:200%;

}

}

.tagline{

margin-top:28px;

font-size:1.05rem;

letter-spacing:.35em;

text-transform:uppercase;

color:var(--muted);

font-weight:500;

}

.scroll-link{

margin-top:65px;

display:inline-flex;

align-items:center;

gap:12px;

padding:16px 26px;

border-radius:999px;

text-decoration:none;

background:rgba(255,255,255,.04);

border:1px solid rgba(255,255,255,.08);

color:#fff;

transition:.3s;

}

.scroll-link:hover{

transform:translateY(-3px);

border-color:rgba(168,85,247,.55);

box-shadow:0 10px 30px rgba(168,85,247,.18);

}

/**************************************************
SECTION
**************************************************/

section{

padding:110px 0;

}

.section-title{

font-size:2.4rem;

font-weight:700;

letter-spacing:-.04em;

margin-bottom:18px;

text-align:center;

}

.section-subtitle{

color:var(--muted);

text-align:center;

margin-bottom:60px;

}

/**************************************************
CARDS
**************************************************/

.grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

gap:28px;

}

.card{

background:var(--surface);

border:1px solid var(--border);

border-radius:var(--radius);

padding:40px;

transition:.35s;

box-shadow:var(--shadow);

}

.card:hover{

transform:translateY(-8px);

background:var(--surface-hover);

border-color:rgba(168,85,247,.35);

}

.card img{

height:72px;

margin-bottom:24px;

}

.card h3{

font-size:1.4rem;

margin-bottom:16px;

}

.card p{

color:var(--muted);

margin-bottom:28px;

}

.card a{

text-decoration:none;

color:#fff;

font-weight:600;

}

/**************************************************
RESPONSIVE
**************************************************/

@media(max-width:900px){

nav{

height:70px;

}

nav ul{

gap:22px;

}

.hero{

padding-top:140px;

}

.tagline{

letter-spacing:.18em;

font-size:.95rem;

}

}

@media(max-width:768px){

nav{

flex-direction:column;

height:auto;

padding:20px 0;

gap:18px;

}

nav ul{

flex-wrap:wrap;

justify-content:center;

}

.hero-logo{

width:88px;

}

.hero h1{

font-size:2.8rem;

}

.section-title{

font-size:2rem;

}

}

</style>

</head>
<style>
  :root{
    --paper:#F7F5EF;
    --card:#FFFFFF;
    --ink:#12163B;
    --ink-soft:#5B5D6E;
    --ink-faint:#9B9CA8;
    --line:#E4E1D6;
    --accent:#2F4BFF;
    --accent-soft:rgba(47,75,255,.07);
    --cyan:#00AEEF;
    --magenta:#EC0868;
    --yellow:#FFD400;
    --key:#12163B;

    /* Headers: Manrope — same humanist-grotesque family as Inter, distinct weights */
    --font-display:'Manrope', 'Inter', Arial, sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;

    --max:1200px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }

  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--font-body);
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }

  a{color:inherit;}
  img{max-width:100%; display:block;}

  .wrap{
    max-width:var(--max);
    margin:0 auto;
    padding:0 32px;
  }
  @media (max-width:640px){ .wrap{padding:0 20px;} }

  .eyebrow{
    font-family:var(--font-mono);
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--ink-faint);
  }

  h1,h2,h3{
    font-family:var(--font-display);
    letter-spacing:-0.01em;
    margin:0;
  }
  h1{ font-weight:800; }
  h2{ font-weight:700; }
  h3{ font-weight:600; }

  p{margin:0;}

  /* --- Registration bar: signature element, bookends the page --- */
  .reg-bar{
    display:flex;
    align-items:center;
    gap:6px;
    height:34px;
  }
  .reg-dot{
    width:9px; height:9px; border-radius:50%;
  }
  .reg-bar .c{background:var(--cyan);}
  .reg-bar .m{background:var(--magenta);}
  .reg-bar .y{background:var(--yellow);}
  .reg-bar .k{background:var(--key);}
  .reg-bar span.label{
    font-family:var(--font-mono);
    font-size:10px;
    letter-spacing:.1em;
    color:var(--ink-faint);
    margin-left:8px;
  }

  /* --- Top strip --- */
  .top-strip{
    border-bottom:1px solid var(--line);
  }
  .top-strip .wrap{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding-top:14px;
    padding-bottom:14px;
  }

  /* --- Nav --- */
  header.nav{
    position:sticky; top:0; z-index:50;
    background:rgba(247,245,239,.88);
    backdrop-filter:saturate(140%) blur(8px);
    border-bottom:1px solid var(--line);
  }
  header.nav .wrap{
    display:flex;
    align-items:center;
    justify-content:space-between;
    height:64px;
  }
  .logo{
    font-family:var(--font-display);
    font-size:20px;
    font-weight:900;
    letter-spacing:-0.01em;
    text-decoration:none;
  }
  nav.links{
    display:flex;
    gap:36px;
    align-items:center;
  }
  nav.links a{
    text-decoration:none;
    font-size:14px;
    color:var(--ink-soft);
    transition:color .15s ease;
  }
  nav.links a:hover, nav.links a:focus-visible{ color:var(--ink); }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-family:var(--font-body);
    font-size:14px;
    font-weight:600;
    text-decoration:none;
    padding:11px 20px;
    border-radius:100px;
    border:1px solid transparent;
    cursor:pointer;
    transition:transform .15s ease, background .15s ease, border-color .15s ease;
  }
  .btn:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
  .btn-primary{ background:var(--ink); color:var(--paper); }
  .btn-primary:hover{ background:var(--accent); transform:translateY(-1px); }
  .btn-ghost{ border-color:var(--line); color:var(--ink); background:transparent; }
  .btn-ghost:hover{ border-color:var(--ink); transform:translateY(-1px); }
  .btn-light{ background:#fff; color:var(--ink); }
  .btn-light:hover{ background:var(--accent); color:#fff; transform:translateY(-1px); }

  .nav-toggle{ display:none; }

  /* ============ HERO ============ */
  .hero{
    position:relative;
    overflow:hidden;
    padding:90px 0 90px;
    background:
      radial-gradient(1100px 500px at 15% -10%, rgba(90,60,220,.35), transparent 60%),
      linear-gradient(180deg, #050508 0%, #0b0a14 34%, #1c1147 68%, #4b31d6 100%);
    color:#fff;
  }
  .hero-inner{
    display:flex;
    align-items:center;
    gap:56px;
    flex-wrap:wrap;
  }
  .hero-copy{
    flex:1 1 420px;
    min-width:320px;
  }
  .hero .eyebrow{ color:rgba(255,255,255,.55); margin-bottom:22px; }
  .hero h1{
    font-size:clamp(34px, 4.6vw, 56px);
    line-height:1.08;
    max-width:15ch;
    color:#fff;
  }
  .hero .byline{
    margin-top:20px;
    font-family:var(--font-mono);
    font-size:13px;
    letter-spacing:.05em;
    color:rgba(255,255,255,.6);
  }
  .hero .actions{
    margin-top:40px;
    display:flex;
    gap:14px;
    flex-wrap:wrap;
  }

  /* --- Hero business grid (clickable, skewed, colorful) --- */
  .hero-grid-wrap{
    flex:1 1 460px;
    min-width:320px;
  }
  .hero-grid{
    display:flex;
    flex-wrap:wrap;
    transform:skewX(-9deg);
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 40px 70px -24px rgba(0,0,0,.65);
  }
  .tile{
    position:relative;
    display:block;
    width:33.3334%;
    height:150px;
    box-sizing:border-box;
    text-decoration:none;
    background:var(--tile-bg);
  }
  .tile:hover, .tile:focus-visible{ filter:brightness(1.1); }
  .tile:focus-visible{ outline:2px solid #fff; outline-offset:-3px; z-index:2; }
  .tile-inner{
    position:absolute; inset:0;
    transform:skewX(9deg);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    padding:12px;
    text-align:center;
  }
  .tile-badge{
    width:50px; height:50px;
    border-radius:12px;
    background-size:cover;
    background-position:center;
    box-shadow:0 8px 18px rgba(0,0,0,.3);
    flex-shrink:0;
  }
  .tile-label{
    font-family:var(--font-display);
    font-weight:700;
    font-size:12px;
    letter-spacing:.01em;
    color:#fff;
    line-height:1.25;
  }
  .tile-arrow{
    position:absolute;
    top:10px; right:10px;
    width:18px; height:18px;
    color:rgba(255,255,255,.75);
    opacity:0;
    transform:translate(-3px,3px);
    transition:opacity .18s ease, transform .18s ease;
  }
  .tile:hover .tile-arrow, .tile:focus-visible .tile-arrow{ opacity:1; transform:translate(0,0); }

  .t-equal{ --tile-bg:linear-gradient(135deg,#FFCB3D,#F97C2A); }
  .t-launchbox{ --tile-bg:linear-gradient(135deg,#12707D,#0B3F52); }
  .t-launchboxwedo{ --tile-bg:linear-gradient(135deg,#B5285A,#701D3C); }
  .t-portfolio{ --tile-bg:linear-gradient(135deg,#332370,#0C0B16); }
  .t-mgifts{ --tile-bg:linear-gradient(135deg,#1E5570,#0E2C40); }
  .t-blprints{ --tile-bg:linear-gradient(135deg,#5B6C93,#31395A); }

  @media (max-width:760px){
    .hero-grid{ transform:skewX(0); }
    .tile{ width:50%; height:135px; }
    .tile-inner{ transform:skewX(0); }
  }

  /* --- Section shell --- */
  section{ padding:96px 0; border-bottom:1px solid var(--line); }
  section:last-of-type{ border-bottom:none; }
  .section-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:24px;
    margin-bottom:52px;
    flex-wrap:wrap;
  }
  .section-head h2{
    font-size:clamp(26px, 3vw, 36px);
    margin-top:14px;
    max-width:22ch;
  }
  .section-head .lede{
    max-width:34ch;
    color:var(--ink-soft);
    font-size:15px;
  }

  /* --- Businesses (Ecosystem) --- */
  .biz-grid{
    display:grid;
    grid-template-columns:1.5fr 1fr;
    gap:20px;
  }
  @media (max-width:900px){ .biz-grid{ grid-template-columns:1fr; } }

  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:18px;
    padding:32px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .card:hover{
    border-color:var(--ink);
    transform:translateY(-3px);
    box-shadow:0 18px 38px -22px rgba(18,22,59,.28);
  }

  .logo-badge{
    width:52px; height:52px;
    border-radius:12px;
    background-size:cover;
    background-position:center;
    box-shadow:0 6px 16px rgba(18,22,59,.18);
    flex-shrink:0;
  }

  .card-primary{ min-height:460px; background:var(--ink); color:var(--paper); border-color:var(--ink); }
  .card-primary:hover{ border-color:var(--accent); }
  .card-primary .tag{
    font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase;
    color:var(--cyan); margin-top:22px;
  }
  .card-primary h3{ font-size:clamp(22px,2.4vw,28px); margin-top:8px; color:#fff; }
  .card-primary p.desc{ margin-top:12px; color:rgba(247,245,239,.72); font-size:14.5px; max-width:38ch; }
  .service-list{ margin-top:22px; display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; }
  .service-list li{
    font-family:var(--font-mono); font-size:11px; letter-spacing:.03em;
    padding:6px 12px; border:1px solid rgba(247,245,239,.22); border-radius:100px;
    color:rgba(247,245,239,.85);
  }
  .card-primary .btn-primary{ background:var(--accent); color:#fff; }
  .card-primary .btn-primary:hover{ background:#4a63ff; }

  .work-strip{ display:flex; gap:8px; margin-top:22px; }
  .work-thumb{
    flex:1; aspect-ratio:4/3; border-radius:10px;
    background:repeating-linear-gradient(45deg, rgba(255,255,255,.06) 0 1px, transparent 1px 10px), rgba(255,255,255,.05);
    border:1px solid rgba(247,245,239,.14);
  }
  .work-strip.light .work-thumb{
    background:repeating-linear-gradient(45deg, var(--line) 0 1px, transparent 1px 10px), var(--accent-soft);
    border:1px solid var(--line);
  }

  .biz-side{ display:flex; flex-direction:column; gap:16px; }
  .card-secondary{ min-height:150px; }
  .card-secondary .row-top{ display:flex; justify-content:space-between; align-items:flex-start; }
  .card-secondary h3{ font-size:18px; margin-top:14px; }
  .card-secondary p.desc{ margin-top:6px; color:var(--ink-soft); font-size:13px; max-width:40ch; }
  .card-secondary .link{
    margin-top:14px; display:inline-flex; align-items:center; gap:6px;
    font-size:13px; font-weight:600; text-decoration:none; color:var(--ink);
  }
  .card-secondary .link svg{ width:13px; height:13px; transition:transform .15s ease; }
  .card-secondary:hover .link svg{ transform:translate(2px,-2px); }

  /* --- Portfolio --- */
  .folio-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; }
  @media (max-width:900px){ .folio-grid{ grid-template-columns:1fr 1fr; } }
  @media (max-width:640px){ .folio-grid{ grid-template-columns:1fr; } }

  .folio-card{
    border:1px solid var(--line); border-radius:16px; overflow:hidden; background:var(--card);
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .folio-card:hover{ transform:translateY(-3px); box-shadow:0 18px 38px -24px rgba(18,22,59,.3); }
  .folio-thumb{
    aspect-ratio:4/3;
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 60%),
      repeating-linear-gradient(45deg, var(--line) 0 1px, transparent 1px 14px);
    border-bottom:1px solid var(--line);
  }
  .folio-body{ padding:22px; }
  .folio-body .eyebrow{ margin-bottom:8px; }
  .folio-body h3{ font-size:17px; }
  .folio-body p{ margin-top:8px; color:var(--ink-soft); font-size:13.5px; }

  .folio-cta{ margin-top:44px; display:flex; justify-content:center; }

  /* --- Why --- */
  .why-list{ display:grid; grid-template-columns:repeat(2, 1fr); gap:0; border-top:1px solid var(--line); }
  @media (max-width:720px){ .why-list{ grid-template-columns:1fr; } }
  .why-item{ padding:30px 0; border-bottom:1px solid var(--line); }
  .why-list .why-item:nth-child(odd){ padding-right:40px; }
  .why-list .why-item:nth-child(even){ padding-left:40px; border-left:1px solid var(--line); }
  @media (max-width:720px){ .why-list .why-item:nth-child(even){ border-left:none; padding-left:0; } }
  .why-item h3{ font-size:17px; font-weight:700; }
  .why-item p{ margin-top:8px; color:var(--ink-soft); font-size:14px; max-width:44ch; }

  .credibility{ margin-top:44px; padding-top:28px; border-top:1px solid var(--line); font-size:14px; color:var(--ink-soft); }

  /* --- Contact --- */
  .contact-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:56px;
  }
  @media (max-width:820px){ .contact-grid{ grid-template-columns:1fr; gap:36px; } }
  .contact h2{ font-size:clamp(28px,3.6vw,44px); max-width:16ch; }
  .contact-lede{ margin-top:16px; color:var(--ink-soft); font-size:15px; max-width:40ch; }
  .contact-email{
    margin-top:24px; display:inline-block;
    font-family:var(--font-mono); font-size:14px; text-decoration:none;
    border-bottom:1px solid var(--ink); padding-bottom:2px;
  }

  .form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width:520px){ .form-grid{ grid-template-columns:1fr; } }
  .field{ display:flex; flex-direction:column; gap:6px; }
  .field.full{ grid-column:1/-1; }
  .field label{ font-size:12.5px; font-weight:600; color:var(--ink-soft); }
  .field input{
    font-family:var(--font-body); font-size:14.5px;
    padding:12px 14px; border-radius:10px; border:1px solid var(--line);
    background:var(--card); color:var(--ink);
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .field input:focus{ outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .contact-form{ margin-top:6px; }
  .contact-form .btn{ margin-top:18px; width:100%; justify-content:center; }
  .form-status{ margin-top:14px; font-size:13.5px; min-height:18px; }
  .form-status.ok{ color:#1B7A3D; }
  .form-status.err{ color:#B4232C; }

  /* --- Footer --- */
  footer{ padding:44px 0 30px; }
