<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  var toggle = document.getElementById('navToggle');
  var links = document.getElementById('navLinks');
  toggle.addEventListener('click', function(){
    var open = links.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  var navA = links.querySelectorAll('a');
  for (var i = 0; i < navA.length; i++) {
    navA[i].addEventListener('click', function(){
      links.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  }

  var revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      for (var j = 0; j < entries.length; j++) {
        if (entries[j].isIntersecting) {
          entries[j].target.classList.add('in');
          io.unobserve(entries[j].target);
        }
      }
    }, { threshold: 0.12 });
    for (var k = 0; k < revealEls.length; k++) { io.observe(revealEls[k]); }
  } else {
    for (var m = 0; m < revealEls.length; m++) { revealEls[m].classList.add('in'); }
  }
  /* Safety net: guarantee content is visible even if IntersectionObserver
     never fires (older engines, embedded previews, etc). */
  setTimeout(function(){
    var els = document.querySelectorAll('.reveal');
    for (var n = 0; n < els.length; n++) { els[n].classList.add('in'); }
  }, 1200);

  /* ---- Contact form -> Google Apps Script -> Google Sheet ----
     1. Deploy Code.gs as a Web App (see instructions in that file).
     2. Paste the deployment URL below.
  */
  var SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzewhTPnEztLlX-2akbLmz3psrrxPFhtmlGprxVJ3WOotf9GU9_u9qZKRd2Uy-1IOE5/exec';

  var form = document.getElementById('contactForm');
  var status = document.getElementById('formStatus');

  form.addEventListener('submit', function(ev){
    ev.preventDefault();

    if (SCRIPT_URL.indexOf('PASTE_YOUR') === 0) {
      status.textContent = 'Form isn\'t connected yet — add your Apps Script URL in the code.';
      status.className = 'form-status err';
      return;
    }

    var payload = {
      name: document.getElementById('f-name').value,
      company: document.getElementById('f-company').value,
      email: document.getElementById('f-email').value,
      phone: document.getElementById('f-phone').value,
      social: document.getElementById('f-social').value
    };

    var submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'form-status';

    fetch(SCRIPT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    })
      .then(function(res){ return res.json(); })
      .then(function(data){
        submitBtn.disabled = false;
        if (data && data.result === 'success') {
          status.textContent = 'Thanks — your message is in. We\'ll be in touch.';
          status.className = 'form-status ok';
          form.reset();
        } else {
          status.textContent = 'Something went wrong. Please email gigi.borbon@gmail.com directly.';
          status.className = 'form-status err';
        }
      })
      .catch(function(){
        submitBtn.disabled = false;
        status.textContent = 'Something went wrong. Please email gigi.borbon@gmail.com directly.';
        status.className = 'form-status err';
      });
  });
</script>

